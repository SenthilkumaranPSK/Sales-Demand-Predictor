# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Buckets
S3_HISTORICAL_DATASETS_BUCKET=demand-forecasting-historical-data
S3_MODEL_ARTIFACTS_BUCKET=demand-forecasting-model-artifacts

# Database Configuration
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=model_registry
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CloudWatch Logging
CLOUDWATCH_LOG_GROUP=/aws/demand-forecasting
CLOUDWATCH_LOG_STREAM=api

# API Configuration
API_KEY_HEADER=X-API-Key
API_KEYS=your-api-key-1,your-api-key-2
RATE_LIMIT_PER_MINUTE=1000
MAX_CONCURRENT_REQUESTS=100

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development
